# Normalise line endings across machines so the workspace behaves identically
# on every host. Repository content is stored with LF; Windows scripts get CRLF.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.node binary
