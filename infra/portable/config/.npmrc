; Workspace-local npm configuration.
; ${WS_ROOT} is expanded by npm from the environment, so no drive letter is
; ever stored in this file. ws-env.ps1 / ws-env.sh export WS_ROOT.
cache=${WS_ROOT}/.cache/npm
prefix=${WS_ROOT}/.local/npm-global
store-dir=${WS_ROOT}/.cache/pnpm-store
fund=false
audit=false
update-notifier=false

; Registry mirror.
; The workspace lives on removable media used from mainland China, where a single
; metadata request to registry.npmjs.org measured 21 to 28 seconds. npmmirror is a
; pull-through mirror of the official registry that serves the same tarballs with
; the same integrity hashes, so pnpm-lock.yaml stays byte-identical and this line
; can be deleted at any time without touching the lockfile.
;
; This applies to every project in the workspace. To fall back to the official
; registry for a single command, override it inline:
;   pnpm install --registry=https://registry.npmjs.org/
registry=https://registry.npmmirror.com/
