# 项目级忽略规则。工作区根级规则负责通用项，本文件负责本项目特有的运行时数据。

# 运行时数据，逐机不同，不纳入版本控制
data/*
!data/.gitkeep

# 客户信息平台的调研与设计记录。**这几份文档通篇含真实客户姓名、手机号、微信群名
# 与员工姓名**（身份规则、金额审计都是拿真实样本举例的，抽掉身份论证就散了）。
# 本仓库远端是公开仓库（2026-10-11 由私有转公开），一旦入库即等于公开发布他人
# 个人信息，因此只留在本机。将来若把仓库转回私有、或把文档重写成无真实样本的版本，
# 删掉这三行即可入库。
docs/CUSTOMER-CRM-*.md
docs/mockups/customer-crm-*.html

# 依赖与构建产物
node_modules/
dist/
build/
out/
.next/
*.tsbuildinfo

# electron-builder 的输出目录（配置在 apps/desktop/electron-builder.yml 的
# directories.output）。里面是安装包与 unpacked 目录，单个文件上十 MB，
# 绝不能进版本控制。注意默认值是 dist/，本项目改成了 release/ 以免和 tsc
# 的 outDir 与 Vite 的构建产物混淆 —— 两个目录同名会让「哪份是要发布的」变成
# 每次都要现查的问题。
release/

# Prisma 生成的客户端。由 `pnpm db:generate` 从 schema 重建，产物随 schema
# 变化而整体重写，提交进来只会制造无意义的 diff 与冲突。
apps/api/src/generated/

# 本地环境变量
.env
.env.local
.env.*.local

# 浏览器级端到端验证的截图与临时浏览器 profile。每次运行重新生成，
# profile 里还带着上一次的登录态，都不该进版本控制。
e2e-shots/

# 编辑器与系统噪声
.DS_Store
Thumbs.db

# ── 千牛采集器（tools/collector）────────────────────────────────────────────
# 采集器的运行时产物一律不进版本控制，只留源码、基线 csv30、口径文档与原型。
# 三处忽略规则（.gitignore / eslint ignores / .prettierignore）必须一起维护。

# Edge 自动化 profile：DPAPI 加密绑定本机账户，换机必失效，单目录数百 MB
tools/collector/.browser-profile*/
# 从千牛导出的登录态（明文 cookie，等同密码）。只在本机存在，用完即删。
tools/collector/.secrets/
# 日增采集产物：一天一个目录，入库后可由 data/ingest 重建
tools/collector/data/daily/
# 30 天原始 JSON：19MB，可重爬
tools/collector/data/raw*/
# 采集器自己导出的入库契约与临时目录（可重生成）
tools/collector/data/ingest/
# 插件链路的采集产物：一天一店一个目录，入库后可由 data/plugin 重建
tools/collector/data/plugin/
# 由 data/plugin 转出的入库 payload，同样是可重生成的中间产物
tools/collector/data/payload/
tools/collector/.tmp/
# 常驻同步的运行日志：机器本地状态，可重新生成
tools/collector/data/sync-watch.log*
# 每日叠加的运行日志，同上
tools/collector/data/daily-catchup.log*
# 调试用的临时日志（仓库根与各 app 下都可能有）
.tmp-*.log

# 截图与报表：可重新生成
tools/collector/preview/*.png
tools/collector/output/*.xlsx
# Agent 工作记忆（随采集器一起移植，不属于源码）
tools/collector/.workbuddy/
