node_modules/
node_modules.old/
dist/

# electron-builder's output directory (`apps/desktop/release/`, see
# `apps/desktop/electron-builder.yml`). Machine artefacts only — a full Electron
# runtime plus the built frontend. It is not `dist/` only because the default
# output directory collides with tsc's outDir, so it slips past the rule above.
release/

# Scratch directory. `ws-env.sh` points TMP/TEMP here, so debug scripts, quarantined
# copies of broken dependencies and one-off forensics all land in it. Git already
# ignores it (workspace-root .gitignore); eslint and prettier must match, or every
# temporary file shows up as a source-level failure. Keep all three in sync.
.tmp/

# Lockfile is generated; formatting it only produces noise in diffs.
pnpm-lock.yaml

# Runtime data and database volumes.
data/

# Prose is authored by hand and reviewed as text. Prettier would reflow the
# Chinese tables in the plan documents, so markdown stays untouched.
**/*.md

# Reference UI mockups are frozen artefacts already reviewed as rendered pages.
docs/mockups/

# 千牛采集器（tools/collector）。这套脚本是从独立工作区移植进来的，与采集源
# 保持一致的价值高于统一格式：它在两台机器之间整目录拷贝，任何一次重新格式化
# 都会让「哪台机器上是哪一版」变得不可比。里面还有 .ps1 与 Python 脚本，
# 它们本就不在 prettier 的处理范围内，混在一起只会增加误改风险。
# 该目录同时加入 .gitignore 之外的 eslint ignores —— 三处必须一起维护。
tools/collector/
