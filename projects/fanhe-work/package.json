{
  "name": "fanhe-work",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @fanhe/shared build && pnpm --filter @fanhe/web dev",
    "dev:api": "pnpm --filter @fanhe/shared build && pnpm --filter @fanhe/api dev",
    "dev:all": "pnpm --filter @fanhe/shared build && pnpm --filter @fanhe/web --filter @fanhe/api --parallel dev",
    "dev:shared": "pnpm --filter @fanhe/shared dev",
    "postinstall": "node apps/desktop/scripts/ensure-electron.mjs",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm --filter @fanhe/shared build && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @fanhe/api db:generate",
    "db:validate": "pnpm --filter @fanhe/api db:validate",
    "db:migrate": "pnpm --filter @fanhe/shared build && pnpm --filter @fanhe/api db:migrate",
    "db:deploy": "pnpm --filter @fanhe/api db:deploy",
    "db:seed": "pnpm --filter @fanhe/shared build && pnpm --filter @fanhe/api db:seed",
    "db:ping": "pnpm --filter @fanhe/api db:ping",
    "db:create-owner": "pnpm --filter @fanhe/shared build && pnpm --filter @fanhe/api db:create-owner",
    "db:studio": "pnpm --filter @fanhe/api db:studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
