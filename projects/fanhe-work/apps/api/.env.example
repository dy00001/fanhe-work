# 复制为 .env 后按本机情况修改。
#
# .env 已被 .gitignore 排除，不会进入版本控制，也不会随 U 盘带走。
# 数据库不随介质移动：换一台机器就要在这里指向那一台机器上的 PostgreSQL 实例。
# 复制命令（在 apps/api 目录下）：
#   PowerShell: Copy-Item .env.example .env
#   bash:       cp .env.example .env
#
# schema=public 不能省。Prisma 默认把表建在 public 下，缺了它部分命令会走错搜索路径。

DATABASE_URL="postgresql://fanhe:fanhe@127.0.0.1:5432/fanhe_work?schema=public"

# 迁移用的影子库。留空时 Prisma 会在目标实例上临时创建并删除一个库，
# 这要求连接账号有 CREATEDB 权限。托管数据库账号通常没有这个权限，
# 那种情况下必须在这里显式指定一个独立的空库。
# SHADOW_DATABASE_URL="postgresql://fanhe:fanhe@127.0.0.1:5432/fanhe_work_shadow?schema=public"

# 密码哈希参数。三项都留空即用默认值，默认值是 OWASP 对 Argon2id 给出的
# 最低推荐档（m=19456 KiB，t=2，p=1，约 19 MiB）。只有需要调整时才取消注释。
#
# ARGON2_MEMORY_KIB 单位是 KiB，直接决定单次哈希占用的内存。并发 10 个登录
# 请求就是 10 倍，所以能开多高取决于部署机器的内存与预期并发。调这一项的
# 收益最直接。Argon2 规范要求它至少是 ARGON2_PARALLELISM 的 8 倍。
#
# 改这些值不会让已有密码失效：PHC 编码的哈希串自带生成时的参数，校验时按
# 串里的参数走，只有新密码才用新参数。
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# 访问令牌的签名密钥。必填，至少 32 字节，没有默认值 —— 默认密钥是最容易
# 一路带到生产环境的东西，而它一旦泄露就等于任何人都能伪造登录态。
#
# 生成方式（在 apps/api 目录下）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# 每套部署用自己的密钥，不要在多台机器之间复用。改了它会让所有已签发的
# 访问令牌立刻失效，这正是密钥泄露时该做的事。
JWT_SECRET=

# 会话有效期。留空即用默认值。
# ACCESS_TOKEN_TTL_SECONDS 默认 900（15 分钟）。访问令牌是无状态的、无法单独
# 撤销，所以它的有效期就是「令牌泄露后还能被用多久」，不宜拉长。
# REFRESH_TOKEN_TTL_DAYS 默认 30，决定「多久不登录就要重新输密码」。
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
