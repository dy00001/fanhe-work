{
  "name": "@fanhe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "pnpm --filter @fanhe/shared build && prisma generate && tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "pnpm --filter @fanhe/shared build && tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed.ts",
    "db:ping": "tsx src/tools/ping-db.ts",
    "db:create-owner": "tsx src/tools/create-owner.ts",
    "db:reset-password": "tsx src/tools/reset-password.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fanhe/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
