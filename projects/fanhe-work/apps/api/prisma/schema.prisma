// 梵禾 Work 数据模型 —— 阶段一：账号与权限
//
// 迁移范围说明
//   账号与权限的七张表在阶段一落地。业务表（launch_profiles、launch_history、
//   notes、events、event_logs）在阶段三随各自模块逐个加入，通过追加迁移演进，
//   不预先建空表 —— 一次迁移只做一件事，出问题时能整条回退。
//
// 命名约定
//   模型名用单数大驼峰，物理表名用复数小写下划线（@@map）。
//   字段名用大驼峰，物理列名用小写下划线（@map）。
//   时间列一律用 timestamptz(3)，避免跨时区与跨机比较时出现歧义。
//   主键统一 UUIDv7，由客户端生成。UUIDv7 前 48 位是毫秒时间戳，索引局部性
//   接近自增列，同时不暴露总量，优于 UUIDv4 与 serial。
//
// 时间戳与软删除的适用范围
//   @@map 之外的三列不是每张表都有，按表的性质区分，规则如下。
//   1. 实体表（users、roles、permissions）：带 createdAt、updatedAt、deletedAt。
//      软删除保证引用过该实体的历史记录不断裂。
//   2. 关联表（role_permissions）：只带 createdAt。取消授权即物理删除该行，
//      授权本身没有需要保留的历史。
//   3. 流水表（login_attempts、refresh_tokens、audit_logs）：只带 createdAt，
//      不做软删除。凭证用 revokedAt 表达失效，审计日志是追加写、不可改不可删。
//      给审计日志加 updatedAt 反而会给出「这行被改过」的错误暗示。
//      login_attempts 同样只增不改，它的失效方式是整行清理，不是标记。
//
// 大小写
//   PostgreSQL 的 text 等值比较区分大小写。username 在写入前由应用层统一
//   归一为小写并去除首尾空白，数据库侧只加唯一约束。这条规则写在服务端，
//   前端提交什么大小写都能登录，但不能依赖数据库做归一。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 枚举
// ---------------------------------------------------------------------------

/// 账号状态。locked 由连续登录失败触发，disabled 由管理员手动设置。
/// 两者分开是为了让解锁与恢复走不同的处理路径。
enum UserStatus {
  active
  locked
  disabled

  @@map("user_status")
}

/// 审计结果。失败也要落库，否则无法回答「谁在反复试密码」。
enum AuditResult {
  success
  failure

  @@map("audit_result")
}

/// 登录尝试的结果。
///
/// 比「成功 / 失败」多一层，因为失败原因决定后续动作：密码错误要计入账号锁定
/// 计数，账号不存在则没有任何账号可更新，只能计入 IP 维度的计数。合并成单一的
/// failure 会让这两类尝试无法分开统计，而「有人在扫不存在的用户名」与「有人在
/// 猜某个账号的密码」需要不同的应对。
enum LoginOutcome {
  success
  /// 用户名查不到对应账号。
  unknown_user
  /// 账号存在但密码不对。
  wrong_password
  /// 账号被停用。
  account_unavailable
  /// 账号处于锁定期内。
  account_locked

  @@map("login_outcome")
}

/// 事件状态。只有两档，不做「进行中」这类中间态 —— 理由见共享包 event.ts：
/// 加一档就要让每个视图回答「它算完成组还是未完成组」，而这类状态在两个分组里
/// 都说不通，最后只会多出一个「其他」组。
///
/// 做成数据库枚举（而不是像 software / outcome 那样用 VarChar），是因为它的取值域
/// 由产品定义、稳定且需要库侧保证不出现第三态。流转是双向的，两次方向都会往
/// event_logs 追一行。
enum EventStatus {
  todo
  done

  @@map("event_status")
}

/// 事件优先级。三档具名，normal 是默认。同样做成枚举：整数档位需要一个「多少算急」
/// 的约定，而那个约定只存在于写代码的人脑子里。
enum EventPriority {
  low
  normal
  high

  @@map("event_priority")
}

// ---------------------------------------------------------------------------
// 实体表
// ---------------------------------------------------------------------------

/// 账号。一个账号只属于一个角色，角色之间是层级关系而非并集关系。
/// 需要多角色时改法是加 user_roles 关联表，届时 users.role_id 退化为默认角色。
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  username     String     @unique @db.VarChar(64)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String     @map("display_name") @db.VarChar(64)
  /// 所属部门。纯展示用途，不参与任何授权判断。
  /// 授权只看 role_id 与 user_permissions 两处，部门只是给人看的分组标签 ——
  /// 把它接进权限判断会让「调岗」变成一次授权变更，而调岗本身不该影响权限。
  /// 允许为空：owner 账号不属于任何部门。
  department   String?    @db.VarChar(64)
  status       UserStatus @default(active)
  roleId       String     @map("role_id") @db.Uuid

  /// 归属这个账号的店铺。归属只影响「看到哪些店」，不参与授权判断 ——
  /// 权限仍然只看 role 与 user_permissions。
  ownedShops EcomShop[]

  /// 连续失败次数与锁定截止时间，服务于登录限速。登录成功后清零。
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// 改密时间。签发访问令牌时带上，改密后旧令牌立即失效。
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  role           Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  launchProfiles LaunchProfile[]
  launchHistory  LaunchHistory[]
  notes          Note[]

  /// 账号级权限覆盖。见 UserPermission。
  userPermissions UserPermission[]

  /// 这个账号名下的事件。
  events          Event[]
  /// 这个账号完成过的事件。与 events 是两条不同的关系，都是指向 users 的外键，
  /// 因此必须命名区分 —— 不命名时 Prisma 无法判断该走哪一条。
  completedEvents Event[]    @relation("EventCompletedBy")
  /// 这个账号留下的事件变更日志。
  eventLogs       EventLog[] @relation("EventLogActor")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

/// 角色。内置四个（owner/admin/member/viewer），isSystem 为 true 的不允许删除。
/// rank 用于比较层级高低：数值大的可以管理数值小的。仅靠 code 做字符串比较
/// 无法表达层级，所以显式存一个整数。
model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique @db.VarChar(32)
  name        String  @db.VarChar(64)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false) @map("is_system")
  rank        Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  users           User[]
  rolePermissions RolePermission[]

  @@index([rank])
  @@map("roles")
}

/// 权限点。code 是「模块.对象.操作」三段式，唯一且是校验时的查表键。
/// 三段同时落成独立列，是为了在管理界面按模块分组展示时不必解析字符串。
/// 本表由种子脚本维护，不接受用户直接增删。
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique @db.VarChar(128)
  module      String  @db.VarChar(32)
  object      String  @db.VarChar(64)
  action      String  @db.VarChar(32)
  description String? @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module, object])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// 关联表
// ---------------------------------------------------------------------------

/// 角色与权限的多对多。复合唯一约束保证同一角色不会重复持有同一权限。
/// 两侧都用级联删除：角色或权限点被物理清理时，关联行失去意义。
/// 正常流程下 roles 与 permissions 都走软删除，级联只在种子重建时触发。
model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// 账号与权限的多对多，用于**账号级**权限覆盖。
///
/// 与 role_permissions 的分工：前者回答「这个角色能做什么」，本表回答「这个账号
/// 额外能做什么、又拿掉了什么」。最终权限 = 角色权限 ∪ 本表 granted − 本表 denied。
///
/// **必须有 denied 一侧，不能只有 granted。** 只做「额外授予」的话，收回某个权限
/// 只能改角色，而改角色会影响所有同角色的人 —— 于是「给张三单独加个查看权限」这件
/// 事做完之后，想撤销就只能把他降级成 viewer，连他原本自带的权限一起丢。显式拒绝
/// 让收回成为一次精确操作，而「按需授予」不能。
///
/// 因此 `granted` 是布尔而不是「存在即授予」：denied 行必须能被写下来。
///
/// **owner 账号不写任何行。** 服务端在算权限时对 owner 短路返回全部权限点，
/// 本表的数据对 owner 一律不生效。这让「owner 不可降权」成为服务端的一条硬规则，
/// 而不依赖「管理员忘了去勾选」这种约定。
model UserPermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  /// 复合唯一：同一账号对同一权限点只能有一条覆盖记录。
  /// 缺了它，「勾上再取消」会插出第二行，而计算权限时哪一行生效取决于查询顺序，
  /// 表现为「取消勾选后有时还生效、有时不生效」。
  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

// ---------------------------------------------------------------------------
// 流水表
// ---------------------------------------------------------------------------

/// 登录尝试记录。既是 IP 维度限速的计数来源，也是登录行为的原始流水。
///
/// 单独一张表，不复用 audit_logs，原因是两者的保留策略相反。审计日志要长期
/// 保留且不可删，而限速计数只需要覆盖一个时间窗口，超期记录必须清掉，否则一张
/// 会被反复写入的表迟早涨到影响查询。把保留策略相反的两类数据放进同一张表，
/// 清理与保留两边都做不成。
model LoginAttempt {
  id String @id @default(uuid(7)) @db.Uuid

  ip       String @db.VarChar(64)
  /// 提交时输入的用户名原样记录。账号不存在时也要留下线索，这是 IP 维度限速
  /// 能发现「有人在扫用户名」的前提。
  username String @db.VarChar(64)

  outcome LoginOutcome

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// IP 维度的限速查询走这个索引：限定 ip 与时间范围后计数。
  @@index([ip, createdAt])
  /// 超期记录的清理走这个索引。
  @@index([createdAt])
  @@map("login_attempts")
}

/// 刷新令牌。只存哈希，明文仅在签发响应的那一刻出现一次。
/// familyId 把一次登录衍生出的整条轮换链归为一组：检测到已用令牌被重放时，
/// 按 familyId 整链撤销，而不是只撤当前这一条。
model RefreshToken {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(255)
  familyId  String @default(uuid(7)) @map("family_id") @db.Uuid

  deviceId   String? @map("device_id") @db.VarChar(128)
  deviceName String? @map("device_name") @db.VarChar(128)
  userAgent  String? @map("user_agent") @db.VarChar(512)
  ip         String? @db.VarChar(64)

  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// 审计日志。追加写，不做更新与删除。
/// actorName 冗余存一份当时的显示名：账号被改名或软删除后，历史记录仍要能读。
/// actorId 用 SetNull 而非 Cascade，删账号不能连带抹掉它做过的操作痕迹。
model AuditLog {
  id         String      @id @default(uuid(7)) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  actorName  String?     @map("actor_name") @db.VarChar(64)
  action     String      @db.VarChar(64)
  targetType String?     @map("target_type") @db.VarChar(64)
  targetId   String?     @map("target_id") @db.VarChar(64)
  result     AuditResult @default(success)
  detail     Json?
  ip         String?     @db.VarChar(64)
  userAgent  String?     @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 业务表（阶段三起随模块逐个加入）
// ---------------------------------------------------------------------------

/// 一键登录启动配置。一条配置对应「点一下就拉起某个客户端实例」。
///
/// **本表存的是本机绝对路径，是全库唯一一处与「受版本控制的文件不出现盘符」这条
/// 约定相冲突的地方。** 处理方式是它压根不进版本控制：路径只存在于运行时数据库，
/// 而数据库的数据目录在忽略规则里。代价是换机后路径可能失效，那由 T3-04 的失效
/// 提示处理，而不是靠不存路径来回避 —— 不存路径这个板块就没有功能。
///
/// 表里没有任何第三方账号的密码。免密登录若要做，只能走操作系统凭据接口
/// （Windows DPAPI 或 Electron safeStorage），属阶段四之后的事，见实施方案 6.1。
///
/// **同用户下不设 name 唯一约束。** 软删除与唯一索引天然冲突：Prisma 的 @@unique
/// 无法附加「deletedAt IS NULL」条件，删掉一条再建同名的会撞约束，而报错信息里
/// 看不出「是因为那条已删除的记录」，用户只会觉得「这个名字明明没人用」。重名检查
/// 放在 service 层，按未删除的行判断。
model LaunchProfile {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// 软件标识。取值域是共享包的 LAUNCH_SOFTWARES，**故意不做成数据库枚举** ——
  /// 新增一个软件不该需要一次迁移。代价是库侧没有约束，由 service 层强制校验，
  /// 少了那一步会攒下前端认不出的标识，表现为列表里某几行图标空白且不报错。
  software String @db.VarChar(32)

  /// 显示名。同一软件配置多条时靠它区分（多账号场景）。
  name String @db.VarChar(64)

  /// 本机可执行文件绝对路径。列宽与共享包的 EXECUTABLE_PATH_MAX 一致。
  executablePath String @map("executable_path") @db.VarChar(1024)

  /// 启动参数。用 text[] 而不是拼接后的字符串：Windows 与 POSIX 的分词规则不同
  /// （双引号成对、反斜杠不作转义、空串的写法都不一样），自己实现一套必然在某个
  /// 边界上与客户端实际行为不一致，而那种不一致只在特定参数上暴露。存数组把
  /// 「哪些算一个参数」交还给用户，启动时直接传给子进程，中间不再有解析环节。
  args String[] @default([])

  /// 图标标识。为空时前端按 software 取默认图标。
  icon String? @db.VarChar(64)

  /// 列表排序序号，升序。重排时整体写成一串连续整数，不留空洞。
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// 用户被物理清理时连带删除。正常流程下 users 走软删除，级联只在种子重建时触发，
  /// 与 refresh_tokens 的处理一致。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 这条配置的启动记录。配置走软删除，因此删掉配置不会带走历史 —— 那正是历史
  /// 该有的行为：删掉一条总是启动失败的配置之后，「它当时到底失败了多少次」还在。
  history LaunchHistory[]

  /// 列表查询恒带 userId 与 deletedAt 两个条件并按 sortOrder 排序，这个复合索引
  /// 正好覆盖，不必再为单列建索引。
  @@index([userId, deletedAt, sortOrder])
  @@map("launch_profiles")
}

/// 启动记录。真实启动尝试成功与失败都写一行，命中去重窗口的请求不写：
/// 去重复用旧结果，重复记会把连点误读为多次成功。
///
/// 这张表**不参与审计**，与启动配置的增删改同一条判断：它是用户自己的使用痕迹，
/// 影响范围不超出他本人，而写进 `audit_logs` 会把真正需要追责的事件淹掉。它要回答
/// 的问题是「这条配置多久没成功启动过了」，服务于界面上的提示，不是追责。
///
/// **保留策略与 `audit_logs` 相反**：这张表会被反复写入且只服务于最近的情况，因此
/// 按用户保留最近若干条，写入时顺带清理（见 `src/launch/history.ts`）。审计日志则
/// 长期保留且不可删。两者的取舍标准是「出事时这条记录还有没有用」。
model LaunchHistory {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid

  /// 配置名与路径的**快照**。历史记的是「当时发生了什么」，而配置随后可能被改名、
  /// 改路径甚至被删掉 —— 排查时最需要的恰恰是当时那一行。冗余在这里是有意的，
  /// 与 `audit_logs` 同时记 actorId 与 actorName 是同一条理由。
  profileName    String @map("profile_name") @db.VarChar(64)
  executablePath String @map("executable_path") @db.VarChar(1024)

  /// 结果码。取值域是共享包的 LAUNCH_RUN_OUTCOMES，与 software 同样**不做成数据库
  /// 枚举**：新增一种失败原因不该需要一次迁移。代价是库侧没有约束，读出来由
  /// `isLaunchRunOutcome` 收窄，认不出的取值按失败处理。
  outcome String @db.VarChar(32)

  /// 子进程 id。失败时为 null —— 那两种失败下进程根本没被创建。
  pid Int?

  /// 结果确认时刻：成功沿用代理的进程创建时间，失败取失败判定时间。
  /// 不可变流水不设 updated_at；只服务近期摘要，不另存 created_at 写入时间。
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)

  /// 物理清理用户或配置时连带删除。正常流程下两者都走软删除，级联只在种子重建时触发。
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile LaunchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// 保留策略的清理按用户与时间倒序取超出部分。
  @@index([userId, startedAt])
  /// 「这条配置最近一次启动」的查询走这个索引。
  @@index([userId, profileId, startedAt])
  @@map("launch_history")
}

/// 工作纪要。
///
/// **正文存 Markdown 原文，不存渲染结果。** 与共享包 note.ts 同一条理由：渲染是
/// 前端的事（T3-06），存 HTML 意味着换一个渲染器就要重写全部历史数据，而且 HTML
/// 里能塞脚本，读到它的人会面临一次注入。
///
/// **标签用 text[] 而不是关联表。** 个人工作台的标签没有独立元数据（颜色、描述），
/// 不需要跨用户共享或重命名统计，开一张 tags 表加一张 note_tags 关联表换来的能力，
/// 用数组加一次聚合也能达到，而代价是两处级联维护。数组查询走 GIN 索引，标签筛选
/// 不必全表扫。这条判断与 `LaunchProfile.args` 用 `String[]` 同源。
///
/// **同用户下不设 title 唯一约束。** 与 `LaunchProfile.name` 同一条判断：软删除与
/// 唯一索引天然冲突。纪要尤其需要允许重名 —— 「周会记录」这种标题一个月会重复
/// 好几次，唯一约束会让它无法保存。
///
/// **归档不是删除。** `archivedAt` 有值时纪要退出默认列表，但仍然可读、可恢复，
/// 与 `deletedAt` 的软删除是两回事。两个状态互相独立：可以先归档再删除，也可以
/// 只归档。
model Note {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// 标题。列宽与共享包的 NOTE_LIMITS.TITLE_MAX 一致。
  title String @db.VarChar(200)

  /// 正文，Markdown 原文。列类型给 text 而不设宽度：上限由共享包的
  /// NOTE_LIMITS.CONTENT_MAX 在应用层强制，改上限不该需要一次迁移。
  content String @db.Text

  /// 标签。已归一，去首尾空白、去重、无空串，归一由 service 层负责。
  /// 数据库侧没有约束（标签是用户的自由分类词），少归一那一步会让「工作」与
  /// 「工作 」在库里共存，而界面上看不出区别。
  tags String[] @default([])

  /// 置顶。置顶的排在列表最前，与更新时间排序叠加。
  pinned Boolean @default(false)

  /// 归档时刻。为 null 表示未归档。用时刻而不是布尔，是因为「什么时候归档的」
  /// 在回头看时有用（「这个月归档了哪些」），布尔表达不了。
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// 用户被物理清理时连带删除。正常流程下 users 走软删除，级联只在种子重建时
  /// 触发，与 refresh_tokens、launch_profiles 的处理一致。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 列表查询恒带 userId 与 deletedAt，按置顶与更新时间排序，这个复合索引正好
  /// 覆盖。时间范围筛选走它的前两列前缀，不必再为 createdAt 单建一条。
  @@index([userId, deletedAt, pinned, updatedAt])
  /// 归档视图按归档时刻倒序取。
  @@index([userId, deletedAt, archivedAt])
  /// 标签筛选走 GIN。数组的包含判断在 B-tree 上用不上。
  @@index([tags], type: Gin)
  @@map("notes")
}

/// 事件记录。个人工作台第三板块的实体表。
///
/// **状态不是这一行上的一个普通列，而是 event_logs 最新一行的投影。** 每次
/// `todo ↔ done` 的流转都往 `event_logs` 追一行，从不修改已有的那行 —— 详情面板
/// 要回答「谁在什么时候完成的」「为什么又被撤销了」，只留一个当前状态答不了。因此
/// 本表的 status / completedAt / completedById / completedByName 四列是**可重建的
/// 冗余**，权威来源在那张流水表里。这一点与纪要的 `pinned` / `archivedAt` 不同：
/// 那两个字段只表达「现在是怎样」，没有历史可言。
///
/// **不做「归档」。** 纪要需要它（旧记录要收起来但还得能查），而事件的时间维度由
/// `status` 与 `completedAt` 表达，再加一层归档只会让「这条到底在哪个视图里」变成
/// 三个状态的组合。真需要收起来时用的是软删除。
///
/// **同用户下不设 title 唯一约束。** 与 Note 同一条判断：软删除与唯一索引天然冲突，
/// 而「与客户确认尺寸」这类标题本来就会重复。
model Event {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// 标题。列宽与共享包的 EVENT_LIMITS.TITLE_MAX 一致。
  title String @db.VarChar(200)

  /// 描述，Markdown 原文。给 text 不设宽度：上限由共享包在应用层强制，改上限不该
  /// 需要一次迁移。与 `Note.content` 同一条处理 —— 渲染是前端的事，原文是唯一事实。
  description String @db.Text

  status   EventStatus   @default(todo)
  priority EventPriority @default(normal)

  /// 标签。已归一，归一的实现复用纪要那套（共享包 `normalizeNoteTags`），不另写
  /// 一份：标签在两个板块里是同一个概念。数据库侧没有约束，少归一那一步会让
  /// 「会议」与「会议 」在库里共存，而界面上看不出区别。
  tags String[] @default([])

  /// 截止时间。为空表示没有截止时间。允许填过去的时刻 —— 补录既有事件时，
  /// 截止时间早于创建时间是常态，拒绝它只会逼用户填一个假的。
  dueAt DateTime? @map("due_at") @db.Timestamptz(3)

  /// 完成时刻。撤销完成时连同下面两列一起清回 null：留一个「完成了但不知道是谁」
  /// 的中间状态没有意义，只会让详情面板多一个分支去猜。
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  /// 完成人 id。用 SetNull 而非 Cascade：删账号不能连带抹掉它做过的操作痕迹，
  /// 与 `audit_logs.actor_id` 同一条处理。正常流程下 users 走软删除，级联只在
  /// 种子重建时触发。
  completedById String? @map("completed_by_id") @db.Uuid

  /// 完成人显示名**快照**。账号改名或被删之后历史仍要能读，与
  /// `audit_logs.actor_name` 是同一条理由：排查时最需要的是当时那一行，而不是
  /// 一个指向当前状态的引用。
  completedByName String? @map("completed_by_name") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedBy User?      @relation("EventCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  /// 这条事件的状态变更流水。事件走软删除，因此删掉它不会带走日志 —— 那正是日志
  /// 该有的行为。级联只在事件被物理清理时触发。
  logs        EventLog[]

  /// 列表查询恒带 userId 与 deletedAt，按状态分组、组内按截止时间升序。这条复合
  /// 索引正好覆盖。截止时间升序时 NULL 排在最后是 PostgreSQL 对 ASC 的默认行为
  /// （NULLS LAST），没有截止时间的事件因此自然落在组尾，不必额外声明排序方向。
  @@index([userId, deletedAt, status, dueAt])
  /// 标签筛选走 GIN。数组的包含判断在 B-tree 上用不上。
  @@index([tags], type: Gin)
  @@map("events")
}

/// 事件状态变更日志。
///
/// **只追加，不做更新与删除**，因此没有 `updatedAt` 与 `deletedAt`。给流水加一个
/// 更新时间戳反而会给出「这行被改过」的错误暗示，而这行的全部价值就在于它记的是
/// 当时发生的事 —— 与 `audit_logs` 完全同一条判断。撤销完成也不是删掉「完成」那
/// 一行，而是再追加一行 `reopened`：删掉它等于抹去「这件事曾经被完成过」。
///
/// **`action` 用 VarChar 而不是数据库枚举。** 取值域会随功能演进（将来可能加
/// 「改期」「指派」），新增一种动作不该需要一次迁移。代价是库侧没有约束，读出来由
/// 共享包的 `isEventLogAction` 收窄，认不出的取值原样展示而不是丢掉 —— 一条动作码
/// 是后来才加的历史记录，在被读到时不该让整个详情面板报错。这条判断与
/// `launch_history.outcome`、`launch_profiles.software` 同源。
///
/// **`actorId` 与 `actorName` 都存。** 与 `audit_logs` 同构：id 供追溯，name 是
/// 快照，账号改名或被删后历史仍读得出来。
model EventLog {
  id      String @id @default(uuid(7)) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  /// 动作码。取值域见共享包 `EVENT_LOG_ACTIONS`。
  action String @db.VarChar(32)

  /// 变更前后的状态。创建时 `fromStatus` 为 null（此前没有状态）。`toStatus` 为
  /// null 只出现在一种情况下：动作码在写入之后才被引入，当时没有可记的目标状态。
  fromStatus EventStatus? @map("from_status")
  toStatus   EventStatus? @map("to_status")

  /// 变更备注，可选。撤销完成时说明原因。列宽与 `EVENT_LIMITS.COMMENT_MAX` 一致。
  comment String? @db.VarChar(200)

  actorId   String? @map("actor_id") @db.Uuid
  actorName String? @map("actor_name") @db.VarChar(64)

  /// 记录时刻。不可变流水不设 `updatedAt`，这一列就是「什么时候发生的」。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// 事件被物理清理时连带删除。正常流程下 events 走软删除，级联只在种子重建时触发。
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// 操作人被物理清理时置空，日志本身保留。
  actor User? @relation("EventLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// 详情面板按 eventId 取全量、按时间正序展示，这条索引正好覆盖。
  @@index([eventId, createdAt])
  @@map("event_logs")
}

// ---------------------------------------------------------------------------
// 运营数据（千牛 / 生意参谋）
// ---------------------------------------------------------------------------
//
// 四张表，全部 `ecom_` 前缀，与账号、纪要、事件这些业务表零耦合。
//
// 为什么不是原方案里的十张（见 docs/QIANNIU-OPS-INTEGRATION-2026-10-19.md §4）：
// 那张设计假定「商品 / 渠道 / 客服 / 推广」都有逐日序列。实际拿到的数据里，
// 只有支付金额、访客、支付买家、商品访客四项是逐日真值，其余（商品排行、渠道
// 结构、地域、搜索词、跳失率、停留时长）接口只给 30 天整段值。按原设计建十张表，
// 其中五张会长期是空表，而空表比没表更糟 —— 后来接手的人会以为「这里本该有数据，
// 只是还没采」，实际是「这个粒度平台不提供」。
//
// 于是收敛成两类事实表：
//   · ecom_daily_metrics       只存可加的逐日量
//   · ecom_dimension_snapshots 存整段维度，**带自己的窗口**（stat_from / stat_to）
// 加 ecom_shops（店铺维度）与 ecom_collect_runs（批次可观测性）。新增维度不需要
// 迁移，加一行 `dim_type` 即可。

/// 店铺平台。
enum EcomPlatform {
  taobao
  tmall

  @@map("ecom_platform")
}

/// 采集浏览器的登录态。由采集器回写，平台侧只存与展示，不自己推断。
///
/// 三档而不是两档：`unknown` 表示「还没验过」，与 `needs_login`（验过且失效）
/// 是两件事。合并成一个会让刚绑定的店铺一进来就顶着「需要重新登录」的红标，
/// 用户会去点一个本来就没问题的按钮。
enum OpsLoginState {
  unknown
  authenticated
  needs_login

  @@map("ops_login_state")
}

/// 数据来源。报表导出与接口直取在个别指标上口径不同，对账时靠这一列区分。
enum EcomCollectSource {
  report
  api

  @@map("ecom_collect_source")
}

/// 采集批次状态。partial 表示部分页面采到、部分空采，需要人看一眼。
enum EcomCollectStatus {
  running
  succeeded
  partial
  failed

  @@map("ecom_collect_status")
}

/// 维度类型。`summary` 是「一行一个指标」的整段值（客单价、跳失率、停留时长），
/// 与前五种「一行一个对象」不同类，见共享包 `OPS_DIMENSION_TYPES` 的注释。
enum EcomDimensionType {
  item
  channel
  area
  keyword
  content
  summary

  @@map("ecom_dimension_type")
}

/// 店铺。当前部署只有一家，表结构保留多店维度 —— 加店只是多一行，不动事实表。
model EcomShop {
  id String @id @default(uuid(7)) @db.Uuid

  /// 稳定代号，采集器用它认店（`fanhe-main`）。不用店铺 id，因为 id 会随重建变化。
  code String @unique @db.VarChar(40)
  name String @db.VarChar(120)

  platform   EcomPlatform @default(taobao)
  sellerNick String?      @map("seller_nick") @db.VarChar(80)

  /// 业务日时区。生意参谋按东八区切日，固定写死，不跟服务器时区走。
  timezone String  @default("Asia/Shanghai") @db.VarChar(40)
  enabled  Boolean @default(true)

  /// 最近一次成功采集完成的时刻。新鲜度徽标读这一列，不另建健康表。
  lastCollectedAt DateTime? @map("last_collected_at") @db.Timestamptz(3)

  /// ---- 绑定状态。这一组字段由「店铺绑定入口」写、由采集器回写，别处只读。 ----
  ///
  /// 绑定的时刻。null 表示这行是种子或 ingest upsert 建出来的，从未经过绑定入口。
  boundAt DateTime? @map("bound_at") @db.Timestamptz(3)

  /// 归属账号。null 表示**公共店铺**：所有持 `ops.shop.read` 的账号都能看到。
  ///
  /// 为什么不强制一个 owner：现有 5 家店是种子写进来的，强制归属要么需要一次
  /// 人工指定（没人知道该给谁），要么在迁移里瞎猜一个 —— 猜错的后果是别人再也
  /// 看不到自己的店，而且没有任何报错。空值当公共，是唯一「不会把现有使用者挡在
  /// 外面」的默认。
  ///
  /// 可见性规则写在 `listOpsShops`：持 `ops.shop.bind` 的看全部，其余人看
  /// 「自己的 + 公共的」。
  ownerId String? @map("owner_id") @db.Uuid

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  /// 采集浏览器的登录态。判据只有一个来源：采集器的 `login-check.mjs`。
  /// 平台侧不猜，避免「界面说有登录、采集器说没有」两套结论。
  loginState OpsLoginState @default(unknown) @map("login_state")

  /// 最近一次校验登录态的时刻。与 `loginState` 成对读：没有这个时间戳的
  /// `authenticated` 是「很久以前验过」，界面要按时间显示新鲜度而不是一个绿点。
  loginCheckedAt DateTime? @map("login_checked_at") @db.Timestamptz(3)

  /// 该店铺专属的 Edge 调试端口。与 `shops.config.json` 里的 port 必须一致，
  /// 不一致时采集器会按配置文件走，这个字段只用于绑定入口做冲突检测与提示。
  collectPort Int? @map("collect_port")

  /// 「请求同步」的标记。绑定成功、或人在界面上点「立即同步」时置为当前时刻，
  /// 采集器轮询到这里就把该店排进这一轮。采完（无论成败）由采集器清空。
  ///
  /// 为什么用一列时间戳而不是消息队列：采集器必须能在平台不可达时继续按本地
  /// 配置跑（`tools/collector/README.md` 的边界），所以触发信号只能是一个「可
  /// 丢失也无所谓」的提示，不能是投递即消费的队列。丢了就等下一次定时。
  syncRequestedAt DateTime? @map("sync_requested_at") @db.Timestamptz(3)

  /// 最近一次同步失败的原因（采集器回写）。成功后清空。
  /// 与 `lastCollectedAt` 配合读：时间戳停在昨天、这一列有值时，界面直接显示原因，
  /// 不必让人去翻脚本日志。
  lastSyncError String? @map("last_sync_error") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  daily     EcomDailyMetric[]
  snapshots EcomDimensionSnapshot[]
  runs      EcomCollectRun[]

  @@index([ownerId])
  @@map("ecom_shops")
}

/// 店铺日指标。只放可加量。
///
/// **金额单位是分，列类型 Int。** 单日上限约 2147 万元，超过说明上游把元当成分
/// 传了 —— 这个上限本身就是一道校验。区间求和由查询侧做，不在这里存汇总行：
/// 存了就要维护，而汇总是随时可算的。
///
/// **业务日是 Date，不是 Timestamptz。** 生意参谋的「日」是自然日，跨时区换算会
/// 把 10 月 1 日的单子算到 9 月 30 日，而这类错位只在月初月末暴露。采集时刻另存
/// `collected_at`。
///
/// 四个指标都可空。**空 ≠ 0**：0 是「当天确实没有」，空是「那一天没采到」。
/// 补 0 会让日均被系统性拉低，而且看不出来。
model EcomDailyMetric {
  id       String   @id @default(uuid(7)) @db.Uuid
  shopId   String   @map("shop_id") @db.Uuid
  statDate DateTime @map("stat_date") @db.Date

  payAmountFen Int? @map("pay_amount_fen")
  visitors     Int?
  payBuyers    Int? @map("pay_buyers")
  itemVisitors Int? @map("item_visitors")

  source      EcomCollectSource @default(report)
  /// 平台会回溯改数。同一业务日多次写入时，这一列标出「本次覆盖了不同的值」。
  revised     Boolean           @default(false)
  collectedAt DateTime          @default(now()) @map("collected_at") @db.Timestamptz(3)

  shop EcomShop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, statDate])
  /// 区间查询恒带这两列，唯一约束的前缀已经覆盖，单建一条是为了让「按店取全部
  /// 日期」这种扫描也走索引，不额外依赖唯一索引的名字。
  @@index([shopId, statDate])
  @@map("ecom_daily_metrics")
}

/// 整段维度快照。一行 = 某店某窗口某维度某对象。
///
/// **窗口进主键。** 同一批商品在 9 月与 10 月各有一份 30 天排行，它们是两份不同的
/// 事实，不能互相覆盖。查询时取「覆盖目标区间的最新一份」，而不是简单取最新 —
/// 否则补采一次历史数据，看板上的当前窗口会退回到历史区间。
///
/// `metrics` 用 Json 而不是为每种维度加列：渠道有转化率、商品有加购金额、地域有
/// 下单转化率，列集合各不相同，摊平成列要么几十个空列，要么每次加指标改一次迁移。
/// 代价是库侧无类型约束，读出来由 `metricNumber()` 收口（读不到就当缺失，不当 0）。
model EcomDimensionSnapshot {
  id      String            @id @default(uuid(7)) @db.Uuid
  shopId  String            @map("shop_id") @db.Uuid
  dimType EcomDimensionType @map("dim_type")

  statFrom DateTime @map("stat_from") @db.Date
  statTo   DateTime @map("stat_to") @db.Date

  /// 稳定键。商品用平台商品 id，渠道 / 地域 / 关键词用归一后的名称。
  dimKey   String @map("dim_key") @db.VarChar(120)
  /// 展示名。商品标题会改，这里存的是快照时点的标题。
  dimLabel String @map("dim_label") @db.VarChar(300)

  metrics Json

  collectedAt DateTime @default(now()) @map("collected_at") @db.Timestamptz(3)

  shop EcomShop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dimType, statFrom, statTo, dimKey])
  @@index([shopId, dimType, statFrom, statTo])
  @@map("ecom_dimension_snapshots")
}

/// 采集批次。这张表是「昨天为什么没数」唯一能回答的地方。
///
/// 与 `audit_logs` 分工：审计记人做了什么，批次记系统做了什么。自动采集不写审计
/// （计划任务里没有操作者），它的可观测性全部落在这里。
/// 采集器心跳。单行表，`id` 固定为 `watch`。
///
/// 为什么需要它：绑定入口点「立即同步」只是置一个时间戳，真正干活的是宿主机的
/// 常驻进程。那个进程没在跑时，界面会一直显示「等待采集器」，用户无法区分
/// 「还在排队」与「根本没人接单」—— 这是整个链路里最误导人的一处。
///
/// 为什么不做成多行事件表：心跳只回答「最近一次有人来拉待办是什么时候」，
/// 历史没有用途。单行 upsert 避免这张表无限增长，也避免每次查询都要排序。
model OpsCollectorHeartbeat {
  /// 固定值 `watch`。留成主键而不是加一行 id，是为了让 upsert 永远命中同一行。
  id String @id @db.VarChar(32)

  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)

  /// 谁在拉待办（`http` / `local`），排查「换了传输方式但心跳没跟上」时有用。
  source String? @map("source") @db.VarChar(20)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ops_collector_heartbeats")
}

model EcomCollectRun {
  id     String   @id @default(uuid(7)) @db.Uuid
  shopId String   @map("shop_id") @db.Uuid

  statFrom DateTime @map("stat_from") @db.Date
  statTo   DateTime @map("stat_to") @db.Date

  /// schedule / manual / backfill。用 VarChar 而不是枚举：新增触发方式不该要一次迁移。
  trigger String            @db.VarChar(20)
  source  EcomCollectSource
  status  EcomCollectStatus @default(running)

  dailyRows     Int @default(0) @map("daily_rows")
  dimensionRows Int @default(0) @map("dimension_rows")

  /// 原始文件相对路径。只记相对路径 —— 工作区在 U 盘上，盘符会变。
  rawPath      String? @map("raw_path") @db.VarChar(300)
  errorMessage String? @map("error_message") @db.Text

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  durationMs Int?      @map("duration_ms")

  shop EcomShop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, startedAt])
  @@index([shopId, statTo])
  @@map("ecom_collect_runs")
}
