// 梵禾 Work 数据模型 —— 阶段一：账号与权限
//
// 迁移范围说明
//   账号与权限的七张表在阶段一落地。业务表（launch_profiles、launch_history、
//   notes、events、event_logs）在阶段三随各自模块逐个加入，通过追加迁移演进，
//   不预先建空表 —— 一次迁移只做一件事，出问题时能整条回退。
//
// 命名约定
//   模型名用单数大驼峰，物理表名用复数小写下划线（@@map）。
//   字段名用大驼峰，物理列名用小写下划线（@map）。
//   时间列一律用 timestamptz(3)，避免跨时区与跨机比较时出现歧义。
//   主键统一 UUIDv7，由客户端生成。UUIDv7 前 48 位是毫秒时间戳，索引局部性
//   接近自增列，同时不暴露总量，优于 UUIDv4 与 serial。
//
// 时间戳与软删除的适用范围
//   @@map 之外的三列不是每张表都有，按表的性质区分，规则如下。
//   1. 实体表（users、roles、permissions）：带 createdAt、updatedAt、deletedAt。
//      软删除保证引用过该实体的历史记录不断裂。
//   2. 关联表（role_permissions）：只带 createdAt。取消授权即物理删除该行，
//      授权本身没有需要保留的历史。
//   3. 流水表（login_attempts、refresh_tokens、audit_logs）：只带 createdAt，
//      不做软删除。凭证用 revokedAt 表达失效，审计日志是追加写、不可改不可删。
//      给审计日志加 updatedAt 反而会给出「这行被改过」的错误暗示。
//      login_attempts 同样只增不改，它的失效方式是整行清理，不是标记。
//
// 大小写
//   PostgreSQL 的 text 等值比较区分大小写。username 在写入前由应用层统一
//   归一为小写并去除首尾空白，数据库侧只加唯一约束。这条规则写在服务端，
//   前端提交什么大小写都能登录，但不能依赖数据库做归一。

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 枚举
// ---------------------------------------------------------------------------

/// 账号状态。locked 由连续登录失败触发，disabled 由管理员手动设置。
/// 两者分开是为了让解锁与恢复走不同的处理路径。
enum UserStatus {
  active
  locked
  disabled

  @@map("user_status")
}

/// 审计结果。失败也要落库，否则无法回答「谁在反复试密码」。
enum AuditResult {
  success
  failure

  @@map("audit_result")
}

/// 登录尝试的结果。
///
/// 比「成功 / 失败」多一层，因为失败原因决定后续动作：密码错误要计入账号锁定
/// 计数，账号不存在则没有任何账号可更新，只能计入 IP 维度的计数。合并成单一的
/// failure 会让这两类尝试无法分开统计，而「有人在扫不存在的用户名」与「有人在
/// 猜某个账号的密码」需要不同的应对。
enum LoginOutcome {
  success
  /// 用户名查不到对应账号。
  unknown_user
  /// 账号存在但密码不对。
  wrong_password
  /// 账号被停用。
  account_unavailable
  /// 账号处于锁定期内。
  account_locked

  @@map("login_outcome")
}

// ---------------------------------------------------------------------------
// 实体表
// ---------------------------------------------------------------------------

/// 账号。一个账号只属于一个角色，角色之间是层级关系而非并集关系。
/// 需要多角色时改法是加 user_roles 关联表，届时 users.role_id 退化为默认角色。
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  username     String     @unique @db.VarChar(64)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String     @map("display_name") @db.VarChar(64)
  status       UserStatus @default(active)
  roleId       String     @map("role_id") @db.Uuid

  /// 连续失败次数与锁定截止时间，服务于登录限速。登录成功后清零。
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// 改密时间。签发访问令牌时带上，改密后旧令牌立即失效。
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  role           Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  launchProfiles LaunchProfile[]
  launchHistory  LaunchHistory[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

/// 角色。内置四个（owner/admin/member/viewer），isSystem 为 true 的不允许删除。
/// rank 用于比较层级高低：数值大的可以管理数值小的。仅靠 code 做字符串比较
/// 无法表达层级，所以显式存一个整数。
model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique @db.VarChar(32)
  name        String  @db.VarChar(64)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false) @map("is_system")
  rank        Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  users           User[]
  rolePermissions RolePermission[]

  @@index([rank])
  @@map("roles")
}

/// 权限点。code 是「模块.对象.操作」三段式，唯一且是校验时的查表键。
/// 三段同时落成独立列，是为了在管理界面按模块分组展示时不必解析字符串。
/// 本表由种子脚本维护，不接受用户直接增删。
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique @db.VarChar(128)
  module      String  @db.VarChar(32)
  object      String  @db.VarChar(64)
  action      String  @db.VarChar(32)
  description String? @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([module, object])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// 关联表
// ---------------------------------------------------------------------------

/// 角色与权限的多对多。复合唯一约束保证同一角色不会重复持有同一权限。
/// 两侧都用级联删除：角色或权限点被物理清理时，关联行失去意义。
/// 正常流程下 roles 与 permissions 都走软删除，级联只在种子重建时触发。
model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// 流水表
// ---------------------------------------------------------------------------

/// 登录尝试记录。既是 IP 维度限速的计数来源，也是登录行为的原始流水。
///
/// 单独一张表，不复用 audit_logs，原因是两者的保留策略相反。审计日志要长期
/// 保留且不可删，而限速计数只需要覆盖一个时间窗口，超期记录必须清掉，否则一张
/// 会被反复写入的表迟早涨到影响查询。把保留策略相反的两类数据放进同一张表，
/// 清理与保留两边都做不成。
model LoginAttempt {
  id String @id @default(uuid(7)) @db.Uuid

  ip       String @db.VarChar(64)
  /// 提交时输入的用户名原样记录。账号不存在时也要留下线索，这是 IP 维度限速
  /// 能发现「有人在扫用户名」的前提。
  username String @db.VarChar(64)

  outcome LoginOutcome

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// IP 维度的限速查询走这个索引：限定 ip 与时间范围后计数。
  @@index([ip, createdAt])
  /// 超期记录的清理走这个索引。
  @@index([createdAt])
  @@map("login_attempts")
}

/// 刷新令牌。只存哈希，明文仅在签发响应的那一刻出现一次。
/// familyId 把一次登录衍生出的整条轮换链归为一组：检测到已用令牌被重放时，
/// 按 familyId 整链撤销，而不是只撤当前这一条。
model RefreshToken {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(255)
  familyId  String @default(uuid(7)) @map("family_id") @db.Uuid

  deviceId   String? @map("device_id") @db.VarChar(128)
  deviceName String? @map("device_name") @db.VarChar(128)
  userAgent  String? @map("user_agent") @db.VarChar(512)
  ip         String? @db.VarChar(64)

  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// 审计日志。追加写，不做更新与删除。
/// actorName 冗余存一份当时的显示名：账号被改名或软删除后，历史记录仍要能读。
/// actorId 用 SetNull 而非 Cascade，删账号不能连带抹掉它做过的操作痕迹。
model AuditLog {
  id         String      @id @default(uuid(7)) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  actorName  String?     @map("actor_name") @db.VarChar(64)
  action     String      @db.VarChar(64)
  targetType String?     @map("target_type") @db.VarChar(64)
  targetId   String?     @map("target_id") @db.VarChar(64)
  result     AuditResult @default(success)
  detail     Json?
  ip         String?     @db.VarChar(64)
  userAgent  String?     @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 业务表（阶段三起随模块逐个加入）
// ---------------------------------------------------------------------------

/// 一键登录启动配置。一条配置对应「点一下就拉起某个客户端实例」。
///
/// **本表存的是本机绝对路径，是全库唯一一处与「受版本控制的文件不出现盘符」这条
/// 约定相冲突的地方。** 处理方式是它压根不进版本控制：路径只存在于运行时数据库，
/// 而数据库的数据目录在忽略规则里。代价是换机后路径可能失效，那由 T3-04 的失效
/// 提示处理，而不是靠不存路径来回避 —— 不存路径这个板块就没有功能。
///
/// 表里没有任何第三方账号的密码。免密登录若要做，只能走操作系统凭据接口
/// （Windows DPAPI 或 Electron safeStorage），属阶段四之后的事，见实施方案 6.1。
///
/// **同用户下不设 name 唯一约束。** 软删除与唯一索引天然冲突：Prisma 的 @@unique
/// 无法附加「deletedAt IS NULL」条件，删掉一条再建同名的会撞约束，而报错信息里
/// 看不出「是因为那条已删除的记录」，用户只会觉得「这个名字明明没人用」。重名检查
/// 放在 service 层，按未删除的行判断。
model LaunchProfile {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// 软件标识。取值域是共享包的 LAUNCH_SOFTWARES，**故意不做成数据库枚举** ——
  /// 新增一个软件不该需要一次迁移。代价是库侧没有约束，由 service 层强制校验，
  /// 少了那一步会攒下前端认不出的标识，表现为列表里某几行图标空白且不报错。
  software String @db.VarChar(32)

  /// 显示名。同一软件配置多条时靠它区分（多账号场景）。
  name String @db.VarChar(64)

  /// 本机可执行文件绝对路径。列宽与共享包的 EXECUTABLE_PATH_MAX 一致。
  executablePath String @map("executable_path") @db.VarChar(1024)

  /// 启动参数。用 text[] 而不是拼接后的字符串：Windows 与 POSIX 的分词规则不同
  /// （双引号成对、反斜杠不作转义、空串的写法都不一样），自己实现一套必然在某个
  /// 边界上与客户端实际行为不一致，而那种不一致只在特定参数上暴露。存数组把
  /// 「哪些算一个参数」交还给用户，启动时直接传给子进程，中间不再有解析环节。
  args String[] @default([])

  /// 图标标识。为空时前端按 software 取默认图标。
  icon String? @db.VarChar(64)

  /// 列表排序序号，升序。重排时整体写成一串连续整数，不留空洞。
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// 用户被物理清理时连带删除。正常流程下 users 走软删除，级联只在种子重建时触发，
  /// 与 refresh_tokens 的处理一致。
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 这条配置的启动记录。配置走软删除，因此删掉配置不会带走历史 —— 那正是历史
  /// 该有的行为：删掉一条总是启动失败的配置之后，「它当时到底失败了多少次」还在。
  history LaunchHistory[]

  /// 列表查询恒带 userId 与 deletedAt 两个条件并按 sortOrder 排序，这个复合索引
  /// 正好覆盖，不必再为单列建索引。
  @@index([userId, deletedAt, sortOrder])
  @@map("launch_profiles")
}

/// 启动记录。真实启动尝试成功与失败都写一行，命中去重窗口的请求不写：
/// 去重复用旧结果，重复记会把连点误读为多次成功。
///
/// 这张表**不参与审计**，与启动配置的增删改同一条判断：它是用户自己的使用痕迹，
/// 影响范围不超出他本人，而写进 `audit_logs` 会把真正需要追责的事件淹掉。它要回答
/// 的问题是「这条配置多久没成功启动过了」，服务于界面上的提示，不是追责。
///
/// **保留策略与 `audit_logs` 相反**：这张表会被反复写入且只服务于最近的情况，因此
/// 按用户保留最近若干条，写入时顺带清理（见 `src/launch/history.ts`）。审计日志则
/// 长期保留且不可删。两者的取舍标准是「出事时这条记录还有没有用」。
model LaunchHistory {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid

  /// 配置名与路径的**快照**。历史记的是「当时发生了什么」，而配置随后可能被改名、
  /// 改路径甚至被删掉 —— 排查时最需要的恰恰是当时那一行。冗余在这里是有意的，
  /// 与 `audit_logs` 同时记 actorId 与 actorName 是同一条理由。
  profileName    String @map("profile_name") @db.VarChar(64)
  executablePath String @map("executable_path") @db.VarChar(1024)

  /// 结果码。取值域是共享包的 LAUNCH_RUN_OUTCOMES，与 software 同样**不做成数据库
  /// 枚举**：新增一种失败原因不该需要一次迁移。代价是库侧没有约束，读出来由
  /// `isLaunchRunOutcome` 收窄，认不出的取值按失败处理。
  outcome String @db.VarChar(32)

  /// 子进程 id。失败时为 null —— 那两种失败下进程根本没被创建。
  pid Int?

  /// 结果确认时刻：成功沿用代理的进程创建时间，失败取失败判定时间。
  /// 不可变流水不设 updated_at；只服务近期摘要，不另存 created_at 写入时间。
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)

  /// 物理清理用户或配置时连带删除。正常流程下两者都走软删除，级联只在种子重建时触发。
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile LaunchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// 保留策略的清理按用户与时间倒序取超出部分。
  @@index([userId, startedAt])
  /// 「这条配置最近一次启动」的查询走这个索引。
  @@index([userId, profileId, startedAt])
  @@map("launch_history")
}
