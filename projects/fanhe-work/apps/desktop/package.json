{
  "name": "@fanhe/desktop",
  "productName": "梵禾 Work",
  "version": "0.3.5",
  "description": "梵禾 Work 桌面外壳：内置静态服务与本机代理，把网页端包成可安装的桌面应用。",
  "author": "梵禾 <dev@fanhe.local>",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/*.test.mjs\"",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "start": "node scripts/launch.mjs",
    "dev": "node scripts/ensure-electron.mjs && tsc -p tsconfig.json && node scripts/launch.mjs",
    "smoke": "node scripts/ensure-electron.mjs && tsc -p tsconfig.json && node scripts/launch.mjs --smoke",
    "dist:dir": "node scripts/check-web-build.mjs && node scripts/sync-version.mjs && tsc -p tsconfig.json && electron-builder --win --dir --publish never",
    "dist": "node scripts/check-web-build.mjs && node scripts/sync-version.mjs && tsc -p tsconfig.json && electron-builder --win --publish never",
    "check:web": "node scripts/check-web-build.mjs",
    "verify:pack": "node --experimental-strip-types scripts/verify-pack.mjs",
    "verify:sign": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "verify:all": "pnpm run verify:sign && pnpm run verify:pack",
    "signing:cert": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-signing-cert.ps1",
    "signing:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-signing-cert.ps1 -CheckOnly",
    "signing:adopt": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-signing-cert.ps1 -AdoptFromArtifact -ArtifactPath",
    "signing:export": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-signing-cert.ps1 -ExportPath",
    "signing:import": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-signing-cert.ps1 -ImportPath",
    "signing:trust": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-signing-cert.ps1 -InstallTrustRoot",
    "signing:trust-check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-signing-cert.ps1 -CheckTrustRoot"
  },
  "dependencies": {
    "@fanhe/shared": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "^6.0.3"
  }
}
