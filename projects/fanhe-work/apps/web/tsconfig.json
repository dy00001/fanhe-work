{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // 允许相对导入带 `.ts` 扩展名。纯模块（如 `lib/launch-detect.ts`）要能在 Node 的
    // `--experimental-strip-types` 下被单测直接加载，而 Node ESM 不会自动补 `.ts`，
    // 于是那些模块里的相对 import 必须写全扩展名。这里显式开启（依赖上面的
    // `noEmit`，它是开启此项的硬前提），不影响构建：Vite 侧本就按扩展名解析。
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    // shadcn/ui 的组件源码统一用 `@/...` 引用项目内的模块。别名只在
    // compilerOptions 里声明，构建侧由 vite.config.ts 的 resolve.alias 对应，
    // 两处必须同时存在，否则类型检查能过而构建会失败。
    //
    // 不写 baseUrl：TypeScript 6 已把它标记为弃用（7.0 起失效），而 paths 在没有
    // baseUrl 时本来就相对于本文件所在目录解析，写上是多余的一层。
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
