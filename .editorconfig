root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,yml,yaml,css,scss,less,html,vue}]
indent_size = 2

[*.{py,sh}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
